    "num2=int(input(\"Enter num 2\"))\n",
    "hcf=1\n",
    "while num2 != 0:\n",
    "        temp = num2\n",
    "        num2 = num1 % num2\n",
    "        num1 = temp\n",
    "        hcf=num1\n",
    "print(f\"HCF = \",hcf)"
